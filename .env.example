# Copiá este archivo a .env.local y completá las claves.

# Claude (correcciones de gramática/semántica y conversación)
ANTHROPIC_API_KEY=
# Opcional: modelo a usar. Por defecto claude-haiku-5-5 (el más barato: menos de USD 1 por mes).
# Para explicaciones más finas: claude-sonnet-5-5 (~20x más caro) o claude-opus-5-5 (~40x más caro).
CLAUDE_MODEL=claude-haiku-5-5

# Azure AI Speech (voz de salida + reconocimiento + evaluación de pronunciación)
AZURE_SPEECH_KEY=
# Región del recurso, p. ej. westeurope, eastus, brazilsouth
AZURE_SPEECH_REGION=westeurope

# Código de acceso: protege la app publicada (obligatorio en producción).
# En local podés dejarlo vacío.
ACCESS_CODE=
