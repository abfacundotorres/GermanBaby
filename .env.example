# Copiá este archivo a .env.local y completá las claves.

# Claude (correcciones de gramática/semántica y conversación)
ANTHROPIC_API_KEY=
# Opcional: modelo a usar. Por defecto claude-opus-5-5.
# claude-haiku-5-5 es ~40x más barato si querés bajar costos.
CLAUDE_MODEL=claude-opus-5-5

# Azure AI Speech (voz de salida + reconocimiento + evaluación de pronunciación)
AZURE_SPEECH_KEY=
# Región del recurso, p. ej. westeurope, eastus, brazilsouth
AZURE_SPEECH_REGION=westeurope
